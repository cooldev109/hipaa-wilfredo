# ---- Neuronita EVF — VPS environment ----
# Copy to .env and fill in. deploy-vps.sh will generate this automatically
# with strong random secrets if it does not exist.

# Database (these also provision the bundled evf-postgres container).
# DATABASE_HOST/PORT are set by docker-compose (evf-postgres:5432) — don't set here.
DATABASE_NAME=neuronita_evf
DATABASE_USER=neuronita
DATABASE_PASSWORD=CHANGE_ME_strong_db_password
# Local container Postgres has no TLS; keep false. Set true only for a managed DB.
DATABASE_SSL=false

# App secrets — generate each with:  openssl rand -hex 32
# ENCRYPTION_KEY MUST be 64 hex chars (32 bytes). NEVER change it after data
# exists, or previously-encrypted patient data becomes unreadable.
JWT_ACCESS_SECRET=CHANGE_ME_64_hex_chars
JWT_REFRESH_SECRET=CHANGE_ME_64_hex_chars
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# Public origin (used for CORS).
CORS_ORIGIN=https://solodevs.net

# Optional: OpenAI key for voice transcription. Leave blank to disable.
OPENAI_API_KEY=
